            "code": "class Solution:\n    def maxArea(self, height: list[int]) -> int:\n        lo, hi = 0, len(height) - 1\n        best = 0\n        while lo < hi:\n            best = max(best, (hi - lo) * min(height[lo], height[hi]))\n            if height[lo] > height[hi]:\n                lo += 1\n            else:\n                hi -= 1\n        return best"
          }
        }
