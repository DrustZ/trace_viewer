          "name": "execute_code",
          "arguments": "{\"language\":\"python3\",\"code\":\"class Solution:\\n    def lengthOfLongestSubstring(self, s: str) -> int:\\n        last = {}\\n        best = left = 0\\n        for i, ch in enumerate(s):\\n            if ch in last:\\n                left = last[ch] + 1\\n            last[ch] = i\\n            best = max(best, i - left + 1)\\n        return best\"}",
