          "name": "execute_code",
          "arguments": "{\"language\":\"python3\",\"code\":\"class Solution:\\n    def maxProfit(self, prices: list[int]) -> int:\\n        best = 0\\n        lo = prices[0]\\n        for p in prices[1:]:\\n            lo = min(lo, p)\\n            best = max(best, p - lo)\\n        return best\"}",
