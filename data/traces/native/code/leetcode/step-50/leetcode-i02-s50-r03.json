          "arguments": "{\"language\":\"python3\",\"code\":\"class Solution:\\n    def isValid(self, s: str) -> bool:\\n        pairs = {')': '(', ']': '[', '}': '{'}\\n        stack = []\\n        for ch in s:\\n            if ch in pairs:\\n                if stack and stack.pop() != pairs[ch]:\\n                    return False\\n            else:\\n                stack.append(ch)\\n        return not stack\"}",
