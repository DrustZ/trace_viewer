# Optional: enables the LLM-backed features (AI filter, trace chat, analysis agent,
# playground replay). Without a key the AI filter falls back to a built-in rule parser
# and the other features show a clear configuration hint — nothing breaks.
ANTHROPIC_API_KEY=

# Model overrides (all default to claude-sonnet-5).
AI_FILTER_MODEL=claude-sonnet-5
AI_CHAT_MODEL=claude-sonnet-5
AI_ANALYSIS_MODEL=claude-sonnet-5
AI_PLAYGROUND_MODEL=claude-sonnet-5

# API server port (the vite dev proxy follows it).
PORT=8787

# Optional but strongly recommended when serving beyond localhost (including Tailscale).
# When set, every API/SSE route except health and the token exchange is locked behind a
# 30-day HttpOnly session cookie. Use a long random value with no surrounding whitespace.
# TRACE_VIEWER_ACCESS_TOKEN=
# Tailscale launcher only: defaults to ~/.trace-viewer/access-token (outside the served repo)
# and creates it mode 0600. A custom file must also remain outside the repository.
# TRACE_VIEWER_ACCESS_TOKEN_FILE=

# Optional extra on-disk corpora. Defaults (data/runs and data/imported) stay enabled.
# Separate roots with ":" on macOS/Linux or ";" on Windows. Prefix a generic folder
# with a run name so, for example, Downloads/data appears as the "work-trial" run.
# TRACE_DATA_ROOTS=work-trial=/absolute/path/to/data

# UI-added folders are restricted to these workspace parents. The default is the parent of this
# repository, which includes a sibling ac_express checkout but not the rest of the home directory.
# Separate multiple parents with the platform path delimiter.
# TRACE_VIEWER_ALLOWED_DATA_PARENTS=/absolute/path/to/Code

# Hard server-side ceiling for any single ACE launch, independent of the form value.
# ACE_MAX_RUN_COST_USD=100

# Set to 1 to allow importing traces from private/loopback URLs (SSRF guard escape hatch).
# ALLOW_PRIVATE_URLS=1
