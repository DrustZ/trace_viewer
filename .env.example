# Optional: enables the LLM-backed features (AI filter, trace chat, analysis agent,
# playground replay). Without a key the AI filter falls back to a built-in rule parser
# and the other features show a clear configuration hint — nothing breaks.
ANTHROPIC_API_KEY=

# Model overrides (all default to claude-sonnet-5).
AI_FILTER_MODEL=claude-sonnet-5
AI_CHAT_MODEL=claude-sonnet-5
AI_ANALYSIS_MODEL=claude-sonnet-5
AI_PLAYGROUND_MODEL=claude-sonnet-5

# API server port (the vite dev proxy follows it).
PORT=8787

# Set to 1 to allow importing traces from private/loopback URLs (SSRF guard escape hatch).
# ALLOW_PRIVATE_URLS=1
